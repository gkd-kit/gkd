{
  "name": "gkd-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "format-kt": "kotlin-format . --write --cache",
    "prepare": "simple-git-hooks",
    "clean-empty-dirs": "node ./scripts/clean-empty-dirs.ts",
    "fetch-selector-dist": "node ./gkd-selector/scripts/fetch-dist.ts",
    "app-tools": "node ./scripts/desktop/index.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "node --test ./scripts/desktop/lib/*.test.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{kt,kts}": "kotlin-format --write --cache"
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "fflate": "^0.8.3",
    "kotlin-format": "^0.0.11",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "error"
    }
  }
}
